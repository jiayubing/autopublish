{
  "name": "autopublish-auth-server",
  "private": true,
  "version": "1.0.0",
  "description": "Isolated AutoPublish authentication and entitlement service",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "migrate": "node scripts/migrate.js",
    "evidence:migration": "node scripts/migration-roundtrip-evidence.js",
    "backup": "node scripts/backup.js",
    "restore-check": "node scripts/restore-check.js",
    "recovery-drill": "node scripts/recovery-drill.js",
    "evidence:backup-restore": "node scripts/backup-restore-evidence.js",
    "integrity-check": "node scripts/integrity-check.js",
    "test:health": "node --test tests/health-semantics.test.js",
    "test:rate-limit": "node --test tests/auth-proxy-rate-limit.test.js",
    "test:health-rate-limit": "npm run test:health && npm run test:rate-limit",
    "authctl": "node scripts/authctl.js",
    "apctl": "node scripts/apctl.js",
    "admin:create": "node scripts/authctl.js admin create",
    "admin:disable": "node scripts/authctl.js user disable",
    "admin:revoke": "node scripts/authctl.js session revoke-all"
  }
}
